# ==============================================================================
# MyFetus - Variaveis de Ambiente (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Banco de Dados (PostgreSQL)
# ------------------------------------------------------------------------------
PG_USER=myfetus_app
PG_PASSWORD=
PG_DATABASE=myfetus
PG_HOST=db
PG_PORT=5432
DB_ROTATION_HOST=localhost
DB_ROTATION_PORT=5434

# ------------------------------------------------------------------------------
# 2. Servidor Backend & Autenticacao
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
JWT_SECRET=
JWT_EXPIRES_IN=8h
#Varíavel é obrigatória, não aceita *
CORS_ORIGIN=http://localhost:8081,http://localhost:19006,http://localhost:3000
TRUST_PROXY=
ENFORCE_HTTPS=false
HSTS_MAX_AGE_SECONDS=31536000
LOG_REQUESTS=false

# Rate Limits da API
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
REGISTER_RATE_LIMIT_MAX=5
ADMIN_READ_RATE_LIMIT_MAX=100
CLINICAL_RATE_LIMIT_MAX=60
DOCS_RATE_LIMIT_MAX=300
API_RATE_LIMIT_MAX=300
RAG_RATE_LIMIT_MAX=20
# Exportacao de dados do titular (E7-02.1): confere senha, por isso o limite e baixo.
DATA_EXPORT_RATE_LIMIT_MAX=5
# Exclusao da conta pelo titular (E7-02): confere senha e e irreversivel.
ACCOUNT_DELETION_RATE_LIMIT_MAX=5

# Retencao dos registros de consentimento (E7-01.1). Prazo pendente de definicao
# institucional: vazio = a rotina `npm run consents:retention` nao altera nada.
CONSENT_RETENTION_DAYS=
# anonymize (remove IP e user agent) ou delete
CONSENT_RETENTION_ACTION=anonymize

# ------------------------------------------------------------------------------
# 3. Criptografia em Repouso & Seguranca (LGPD)
# ------------------------------------------------------------------------------
# AES-256-GCM para 110 colunas sensiveis (chave hex de 64 caracteres / 32 bytes)
AES_KEY_VERSION=1
AES_ENCRYPTION_KEY_V1=
# HMAC-SHA256 para busca de e-mail indexavel (chave hex de 64 caracteres)
EMAIL_LOOKUP_HMAC_KEY=

# Armazenamento e upload de arquivos cifrados
DOCUMENT_STORAGE_DIR=uploads/encrypted
DOCUMENT_MAX_UPLOAD_BYTES=26214400
ORPHAN_FILE_MINIMUM_AGE_MS=3600000

# ------------------------------------------------------------------------------
# 4. Processamento de Documentos de Exames & OCR
# ------------------------------------------------------------------------------
ENABLE_DOCUMENT_OCR=true
PDF_TEXT_MIN_LENGTH_FOR_OCR=50
OCR_LANGUAGES=por+eng
PDF_OCR_SCALE=2.0
DOCUMENT_EXTRACTION_INTERVAL_MS=30000
DOCUMENT_EXTRACTION_BATCH_SIZE=5
DISABLE_DOCUMENT_EXTRACTION_QUEUE=false

# ------------------------------------------------------------------------------
# 5. Modulo RAG & Inteligencia Artificial
# ------------------------------------------------------------------------------
# Banco Vetorial (Pinecone) - Opcional para dev basico; obrigatorio para RAG real
PINECONE_API_KEY=
PINECONE_INDEX_NAME=myfetus-rag
PINECONE_NAMESPACE=guidelines

# Embeddings Locais (Xenova/multilingual-e5-small, 384 dimensoes)
EMBEDDING_MODEL=Xenova/multilingual-e5-small
EMBEDDING_DIMENSION=384
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=150

# LLM Chat Clinico (Google Gemini - aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 6. Frontend Mobile (Expo / React Native)
# ------------------------------------------------------------------------------
# URL base da API para o app mobile (emulador Android usa 10.0.2.2:3000; fisico usa IP da LAN)
EXPO_PUBLIC_API_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 7. Testes, Scripts & Simulacoes de Estresse
# ------------------------------------------------------------------------------
RAG_BASE_URL=http://localhost:3000
RAG_TEST_BASE_URL=http://localhost:3000
RAG_TEST_JWT=
JWT_TEST_TOKEN=
RAG_TIMEOUT_MS=5000
RAG_MAX_ATTEMPTS=2
RAG_RETRY_DELAY_MS=100
RUN_STRESS_INTEGRATION=0
ENV_FILE_PATH=
